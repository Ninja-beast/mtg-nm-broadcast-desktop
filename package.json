{
  "name": "mtg-broadcast-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "Windows-app: turnering-motor + lokal API/WebSocket for OBS og mobilkontroll",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "tsc -p electron/tsconfig.json && cross-env NODE_ENV=development electron .",
    "build": "tsc -p electron/tsconfig.json && vite build",
    "package": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "package:dev": "npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "publish-update": "npm version patch --no-git-tag-version && npm run build && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish always"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "electron-updater": "^6.3.9",
    "express": "^4.19.2",
    "obs-websocket-js": "^5.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "@electron/rebuild": "^3.6.0",
    "typescript": "^5.5.4",
    "vite": "^5.3.1"
  },
  "build": {
    "appId": "no.mtgnm.broadcastdesktop",
    "productName": "MTG NM Broadcast Desktop",
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "extraResources": [
      {
        "from": "overlay",
        "to": "overlay"
      }
    ],
    "win": {
      "target": "nsis"
    },
    "publish": {
      "provider": "github",
      "owner": "Ninja-beast",
      "repo": "mtg-nm-broadcast-desktop",
      "releaseType": "release"
    }
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "electron@31.7.7": true,
    "esbuild@0.21.5": true
  }
}
